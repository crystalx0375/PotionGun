{
	"schemaVersion": 1,
	"id": "potiongun",
	"version": "${version}",
	"name": "EVERGun",
	"description": "A simple mod which adds an arrow gun into the game with 2 new vanilla enchantments",
	"authors": [
        "EVER2east", "Crystal"
	],
	"contact": {
        "homepage": "https://modrinth.com/project/evergun",
        "sources": "https://github.com/crystalx375/EVERGun",
        "issues": "https://github.com/crystalx375/EVERGun/issues"
	},
	"license": "MIT",
	"icon": "assets/potiongun/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "crystal.potiongun.PotionGun"
		],
		"client": [
          "crystal.potiongun.client.PotiongunClient"
		],
        "fabric-datagen": [
          "crystal.potiongun.DataGen"
        ]
	},
	"mixins": [
		"potiongun.mixins.json",
		{
			"config": "potiongun.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": ">=1.21 <=1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}